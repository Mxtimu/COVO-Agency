# COVO — Apache config for xneelo shared hosting
# Vite copies everything in public/ into dist/, so this ships with the build.

# ── Force HTTPS ──────────────────────────────────────────────────────
# Supabase OAuth will not redirect back to an insecure origin, so the
# whole auth flow depends on this.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── SPA fallback ───────────────────────────────────────────────────
  # React Router owns the URLs. Without this, loading /auth/callback or
  # /dashboard/brand directly returns a 404 from Apache, because no such
  # file exists on disk. Anything that is not a real file or directory
  # gets index.html and lets the router resolve it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ── Caching ──────────────────────────────────────────────────────────
# Vite fingerprints asset filenames (index-a1b2c3d4.js), so they can be
# cached hard. index.html must never be cached, or browsers keep loading
# an old build that points at deleted asset files.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ──────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ── Basic hardening ──────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to source maps and dotfiles in production
<FilesMatch "\.(map|env)$">
  Require all denied
</FilesMatch>
