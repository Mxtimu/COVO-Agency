# Cloudflare Pages response headers.
#
# The CSP is tight because this site needs almost nothing: its own origin for
# the waitlist POST, and Google Fonts for the two typefaces. There is no
# analytics, no embeds and no third-party scripts, so anything else appearing
# here later is worth questioning rather than appending to.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

# The page is edited by hand and deployed rarely, so it is revalidated on every
# request. A stale marketing page announcing a launch that already happened is
# worse than one extra round trip.
/
  Cache-Control: public, max-age=0, must-revalidate

/api/*
  Cache-Control: no-store
